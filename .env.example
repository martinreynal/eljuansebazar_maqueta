# Copiá este archivo como .env.local para probar en tu compu.
# En Vercel, cargá las mismas variables en Settings → Environment Variables.

# Supabase → Project Settings → API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Dirección pública del sitio (sin barra final). Se usa en links de WhatsApp, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://eljuansebazar.vercel.app
